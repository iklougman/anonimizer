# --- Backend ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# CORS_ALLOWED_ORIGINS requires JSON array syntax, not comma-separated values.
# CORS_ALLOWED_ORIGINS=["https://example.com"]
# Uncomment to move the frontend off host port 3000 (e.g. if it collides
# with another project's dev server).
# FRONTEND_PORT=3100

# --- Postgres ---
POSTGRES_USER=chatgpt_proxy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=chatgpt_proxy
# Password for the restricted app_runtime Postgres role (not the admin
# POSTGRES_USER/PASSWORD above, which is only used for migrations).
APP_RUNTIME_PASSWORD=change-me-app-runtime
# Password for the app_ops Postgres role used only by the internal ops_admin
# (Django) service -- BYPASSRLS, scoped to the apps/tenant_app_entitlements
# catalog tables only. Never exposed to the frontend or the public reverse proxy.
APP_OPS_PASSWORD=change-me-app-ops
# Secret key for the internal ops_admin (Django) service session/CSRF signing.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-generate-a-real-secret

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# --- Frontend origin allowed to call the backend API ---
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# --- LLM Gateway ---
# "ollama" (local, no egress), "openai" (external egress; only sanitized text
# ever crosses this boundary -- ADR-0013, ADR-0022), or "stub" (e2e/CI only,
# deterministic echo provider -- forbidden in production by a startup validator).
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1
# Required only when LLM_PROVIDER=openai. Only synthetic/fabricated data is ever
# sent to OpenAI in this project (ADR-0022) -- never real or real-derived patient data.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# DEBUG ONLY: when false, the deanonymize step skips the post-LLM leakage scan
# and returns the LLM's raw completion (tokens resolved) so an operator can
# inspect what the model actually produced. The outbound sanitize step is
# unaffected; only the response guard is bypassed. Must remain true (or unset)
# outside development -- a false value may return PII the model hallucinated.
# OUTPUT_GUARD_ENABLED=true

# --- Frontend auth (NextAuth + Keycloak) ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-generate-a-real-secret

# --- Reverse proxy / scaling (production-mode only; docker-compose.override.yml
# bypasses Traefik entirely for local dev) ---
# Real public DNS name once deployed; self-signed TLS is used by default so
# this also works with the default "localhost" for a local non-dev-override
# smoke test. Set ACME_EMAIL and switch the router `tls=true` labels in
# docker-compose.yml to `tls.certresolver=letsencrypt` to get a real cert.
PUBLIC_HOST=localhost
ACME_EMAIL=
# Re-measure with a load test before trusting these on a different host size
# (see the comment above the `backend` service in docker-compose.yml).
UVICORN_WORKERS=4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# --- Admin API Keycloak provisioning (optional) ---
# Unset (default): POST /api/admin/users only supports "link an existing
# Keycloak subject" mode. Set both to enable creating new Keycloak users
# from the admin UI, via the confidential chatgpt-proxy-backend-admin
# client (keycloak/realm-export.json) with realm-management roles
# manage-users/view-users.
KEYCLOAK_ADMIN_CLIENT_ID=chatgpt-proxy-backend-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=
